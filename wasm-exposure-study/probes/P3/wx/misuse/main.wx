#[memory_limits(min_pages = 1)]
memory a: Memory where { Size = u32 };
#[memory_limits(min_pages = 1)]
memory b: Memory where { Size = u32 };

fn wrong() -> i32 {
  local pa = 0 as a::*u8;
  local pb = 0 as b::*u8;
  // pointer into memory b passed where memory a is expected
  memory_copy::<u32, a, b>(pa, pb, 4);
  pa.* as i32
}

export {
  wrong
}
