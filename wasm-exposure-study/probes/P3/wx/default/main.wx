#[memory_limits(min_pages = 1)]
memory a: Memory where { Size = u32 };
#[memory_limits(min_pages = 1)]
memory b: Memory where { Size = u32 };

fn copy_test() -> i32 {
  (0 as a::*u8).* = 1;
  (1 as a::*u8).* = 2;
  (2 as a::*u8).* = 3;
  (3 as a::*u8).* = 4;
  memory_copy::<u32, a, b>(0 as b::*u8, 0 as a::*u8, 4);
  (0 as b::*u8).* as i32 + (1 as b::*u8).* as i32 + (2 as b::*u8).* as i32 + (3 as b::*u8).* as i32
}

export {
  copy_test
}
