// words, floor ABI: export memory, alloc(len) -> ptr, analyse(ptr, len) -> ptr to { words, bytes, longest_ptr, longest_len }.
// Memory map: 512 = the 16-byte record, 1024.. = the input (bump-allocated, reset by each analyse).
#[memory_limits({ min_pages: 3 })]
memory heap: u32;

global mut top: u32 = 1024;

func alloc(len: u32) -> u32 {
    local at = top.get();
    top.set(at + (len + 7) / 8 * 8);
    at
}

func is_space(c: u8) -> Bool {
    c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

func analyse(ptr: u32, len: u32) -> u32 {
    local text = slice_from_parts::<heap, u8>(
        RawPtr::<heap, u8>::from_addr(ptr).as_ref(),
        len,
    );
    local mut words: u32 = 0;
    local mut best: u32 = 0;
    local mut best_at: u32 = 0;
    local mut i: u32 = 0;
    loop {
        if i == len { break };
        if is_space(text[i]) {
            i += 1;
            continue
        };
        local start = i;
        loop {
            if i == len || is_space(text[i]) { break };
            i += 1;
        }
        words += 1;
        if i - start > best {
            best = i - start;
            best_at = start;
        }
    }
    top.set(1024);
    local record = slice_from_parts_mut::<heap, u32>(
        RawPtr::<heap, u32>::from_addr(512).as_ptr(),
        4,
    );
    record[0] = words;
    record[1] = len;
    record[2] = ptr + best_at;
    record[3] = best;
    512
}

export {
    heap as "memory",
    alloc,
    analyse,
}
